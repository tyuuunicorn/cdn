<script>
(function () {
  function noop() {}
  function ok(v) { return function () { return Promise.resolve(v); }; }

  var player = {
    getUniqueID: function () { return 'local'; },
    getName: function () { return 'Player'; },
    getPhoto: function () { return ''; },
    getMode: function () { return 'lite'; },
    getData: function () { var d = {}; try { d = JSON.parse(localStorage.getItem('sab_save') || '{}'); } catch (e) {} return Promise.resolve(d); },
    setData: function (d) { try { localStorage.setItem('sab_save', JSON.stringify(d || {})); } catch (e) {} return Promise.resolve(); },
    getStats: ok({}), setStats: ok(), incrementStats: ok({}),
    signIn: function () { return Promise.reject(new Error('no auth')); }
  };

  function advCall(o, name, arg) {
    try { if (o && o.callbacks && typeof o.callbacks[name] === 'function') o.callbacks[name](arg); } catch (e) {}
  }

  window.ysdk = {
    environment: { app: { id: 'local' }, browser: { lang: 'en' }, i18n: { lang: 'en', tld: 'com' }, payload: null },
    deviceInfo: { type: 'desktop', isDesktop: function () { return true; }, isMobile: function () { return false; },
                  isTablet: function () { return false; }, isTV: function () { return false; } },
    adv: {
      showFullscreenAdv: function (o) { setTimeout(function () { advCall(o, 'onClose', false); }, 0); },
      showRewardedVideo: function (o) { setTimeout(function () { advCall(o, 'onOpen'); advCall(o, 'onRewarded'); advCall(o, 'onClose'); }, 0); },
      showBannerAdv: ok({ reason: 'unknown' }), hideBannerAdv: ok({}),
      getBannerAdvStatus: ok({ stickyAdvIsShowing: false })
    },
    features: { LoadingAPI: { ready: noop }, GameplayAPI: { start: noop, stop: noop },
                GamesAPI: { getAllGames: ok({ games: [] }), getGameByID: ok({}) } },
    screen: { fullscreen: { status: 'off', request: ok(), exit: ok() } },
    getPlayer: ok(player),
    getLeaderboards: ok({ getLeaderboardDescription: ok({}),
      getLeaderboardPlayerEntry: function () { return Promise.reject(new Error('no entry')); },
      getLeaderboardEntries: ok({ entries: [] }), setLeaderboardScore: ok() }),
    getPayments: ok({ purchase: ok({}), getPurchases: ok([]), getCatalog: ok([]), consumePurchase: ok() }),
    getStorage: ok(window.localStorage), getFlags: ok({}), isAvailableMethod: ok(false),
    clipboard: { writeText: ok() },
    shortcut: { canShowPrompt: ok({ canShow: false }), showPrompt: ok({ outcome: 'rejected' }) },
    feedback: { canReview: ok({ value: false }), requestReview: ok({ feedbackSent: false }) },
    EVENTS: {}, on: noop, off: noop, dispatchEvent: noop
  };
  window.YaGames = { init: function () { return Promise.resolve(window.ysdk); } };
  window.getWebsite_URL = function () { return '//classroom.google.com'; };
  window.initSDK = noop;
})();
</script>

<script>
(function () {
  var F = window.GAME_FILES;
  var boot = document.getElementById('boot');
  var txt  = document.getElementById('boottxt');
  var fill = document.getElementById('bootfill');
  var shown = 0;

  function setPct(p) {
    p = Math.max(0, Math.min(100, p | 0));
    if (p < shown) return;
    shown = p; fill.style.width = p + '%'; txt.textContent = 'LOADING ' + p + '%';
  }
  function fail(m) { boot.classList.add('err'); txt.textContent = m; fill.style.width = '100%'; }

  var KEYS = Object.keys(F).sort(function (a, b) { return b.length - a.length; });

  function lookup(raw) {
    var u = String(raw || '');
    if (!u || /^(blob:|data:)/i.test(u)) return null;
    var p = u.split('#')[0].split('?')[0];
    for (var i = 0; i < KEYS.length; i++) {
      var k = KEYS[i];
      if (p === k || p.slice(-(k.length + 1)) === '/' + k) return F[k];
    }
    return null;
  }

  var link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = F['style.css'];
  document.head.appendChild(link);

  var DB = 'sab_assets', STORE = 'f', TTL = 30 * 24 * 60 * 60 * 1000;
  var dbp = null, cacheOn = !!window.indexedDB;

  function db() {
    if (!cacheOn) return Promise.resolve(null);
    return dbp || (dbp = new Promise(function (res) {
      var rq;
      try { rq = indexedDB.open(DB, 1); } catch (e) { cacheOn = false; return res(null); }
      rq.onupgradeneeded = function () { try { rq.result.createObjectStore(STORE); } catch (e) {} };
      rq.onsuccess = function () { res(rq.result); };
      rq.onerror = function () { cacheOn = false; res(null); };
    }));
  }
  function cGet(k) {
    return db().then(function (d) {
      if (!d) return null;
      return new Promise(function (res) {
        try {
          var r = d.transaction(STORE, 'readonly').objectStore(STORE).get(k);
          r.onsuccess = function () { var v = r.result; res(v && v.b && (Date.now() - v.t) < TTL ? v : null); };
          r.onerror = function () { res(null); };
        } catch (e) { res(null); }
      });
    }).catch(function () { return null; });
  }
  function cPut(k, buf, type) {
    return db().then(function (d) {
      if (!d) return;
      try { d.transaction(STORE, 'readwrite').objectStore(STORE).put({ b: buf, c: type || '', t: Date.now() }, k); } catch (e) {}
    }).catch(function () {});
  }
  (function () {
    db().then(function (d) {
      if (!d) return;
      try {
        var cur = d.transaction(STORE, 'readwrite').objectStore(STORE).openCursor();
        cur.onsuccess = function () {
          var c = cur.result; if (!c) return;
          var v = c.value;
          if (!v || !v.t || (Date.now() - v.t) >= TTL) { try { c.delete(); } catch (e) {} }
          c.continue();
        };
      } catch (e) {}
    });
  })();
  try { if (navigator.storage && navigator.storage.persist) navigator.storage.persisted().then(function (o) { if (!o) navigator.storage.persist(); }); } catch (e) {}

  var PIX = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==';
  function pngPixel() {
    var raw = atob(PIX), u8 = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) u8[i] = raw.charCodeAt(i);
    return new Response(u8, { status: 200, headers: { 'Content-Type': 'image/png' } });
  }

  var _fetch = window.fetch.bind(window);

  window.fetch = function (input, init) {
    var url = typeof input === 'string' ? input : (input && input.url) || '';
    if (/icons\/[^\/]*\.png$/i.test(url)) return Promise.resolve(pngPixel());
    if (/appmanifest\.json$/i.test(url))
      return Promise.resolve(new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } }));
    var hit = lookup(url);
    if (!hit || (init && init.method && init.method !== 'GET')) return _fetch(hit || input, init);
    var key = hit;
    return cGet(key).then(function (c) {
      if (c) return new Response(c.b, { status: 200, headers: c.c ? { 'Content-Type': c.c } : {} });
      return _fetch(hit, init).then(function (r) {
        if (!r.ok) return r;
        var type = r.headers.get('content-type') || '';
        return r.clone().arrayBuffer().then(function (b) { cPut(key, b, type); return r; }, function () { return r; });
      });
    }).catch(function () { return _fetch(hit, init); });
  };

  try {
    var XP = XMLHttpRequest.prototype, _xopen = XP.open;
    XP.open = function (m, u) { var h = lookup(u); if (h) arguments[1] = h; return _xopen.apply(this, arguments); };
  } catch (e) {}

  function loadScript(url, mod) {
    return new Promise(function (res, rej) {
      var s = document.createElement('script');
      if (mod) s.type = 'module';
      s.src = url;
      s.onload = function () { res(); };
      s.onerror = function () { rej(new Error('could not load ' + url.split('/').pop())); };
      document.body.appendChild(s);
    });
  }

  var creep = setInterval(function () { setPct(shown + 1); }, 220);
  setPct(2);

  loadScript(F['box2d.wasm.js']).then(function () {
    setPct(25);
    return loadScript(F['scripts/offlineclient.js'], true);
  }).then(function () {
    setPct(35);
    return loadScript(F['scripts/main.js'], true);
  }).then(function () {
    setPct(55);
    if (!self.RuntimeInterface) throw new Error('runtime missing');
    window['C3_IsSupported'] = true;
    window['c3_runtimeInterface'] = new self.RuntimeInterface({
      useWorker: false,
      workerMainUrl: 'workermain.js',
      engineScripts: [F['scripts/c3runtime.js']],
      projectScripts: [[F['scripts/project/scriptsInEvents.js']]],
      mainProjectScript: '',
      scriptFolder: 'scripts/',
      workerDependencyScripts: [],
      exportType: 'html5',
      runtimeBaseUrl: "https://cdn.jsdelivr.net/gh/tyuuunicorn/cdn@main/"
    });
    var hide = setInterval(function () {
      if (document.querySelector('canvas')) {
        clearInterval(hide); clearInterval(creep); setPct(100);
        setTimeout(function () { boot.classList.add('gone'); }, 450);
      }
    }, 150);
    setTimeout(function () { clearInterval(hide); clearInterval(creep); boot.classList.add('gone'); }, 40000);
  }).catch(function (e) {
    clearInterval(creep);
    fail('The game could not start. ' + (e && e.message ? e.message : ''));
  });
})();
</script>
<!-- Sticky Bottom Center Ad (728x90) with Smooth Slide-Out and Reappearance -->
<style>
  /* Container: Bottom center, fixed, with overflow hidden */
  #ad-container {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(728px, calc(100% - 20px)); /* 728px, 10px margin on mobile */
    height: 90px;
    background: rgba(0, 0, 0, 0.90);
    display: none;
    z-index: 99999;
    border-radius: 0; /* Sharp corners */
    overflow: hidden;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    transition: transform 0.5s ease-in-out; /* Smooth slide-in/out animation */
  }

  /* Slide-out animation */
  #ad-container.hidden {
